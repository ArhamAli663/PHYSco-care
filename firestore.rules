rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Appointments: anyone can create (book), anyone can read (doctor portal loads all)
    // Only authenticated users can update status
    match /appointments/{docId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }

    // Questions: patients can ask without auth, reads are open
    match /questions/{docId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;
    }

    // Reviews: open read/write
    match /reviews/{docId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }

    // Users collection: open read/write (app manages its own auth logic)
    match /users/{docId} {
      allow read, write: if true;
    }
  }
}
